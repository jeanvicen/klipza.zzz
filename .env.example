# Variáveis server-side para Vercel. Nunca coloque valores reais no GitHub ou no frontend.
# No painel do Vercel, use Project Settings > Environment Variables.

# Qwen / Alibaba Model Studio — informe a base URL do workspace e região.
QWEN_BASE_URL=https://SEU_WORKSPACE.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# Hermes Agent — informe o endpoint HTTPS do seu gateway Hermes.
HERMES_BASE_URL=https://seu-hermes.example.com/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent

# O código só lê estas variáveis no backend serverless.
# Não use prefixos públicos como VITE_, NEXT_PUBLIC_ ou similares.
